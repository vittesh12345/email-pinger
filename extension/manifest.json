{
  "manifest_version": 3,
  "name": "Pinger side panel",
  "version": "0.1.0",
  "description": "Shows Pinger in the browser side panel, next to your mail.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:4317/*"
  ],
  "action": {
    "default_title": "Open Pinger in the side panel",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
